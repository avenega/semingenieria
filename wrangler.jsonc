{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "semingenieria",
  "workers_dev": true,
  "account_id": "deac1cb839e8f43cebe1f05d29e486e6",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-09-21",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Worker primero: APIs + 404/500 HTML personalizados en todos los paths
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    { "pattern": "semingenieria.com.py", "custom_domain": true },
    { "pattern": "www.semingenieria.com.py", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "semingenieria-cms",
      "database_id": "cd7a2375-a972-42df-9277-6431899f03ad",
      "migrations_dir": "migrations"
    }
  ],
  // R2: habilitar en dashboard Semingepy y descomentar cuando exista el bucket.
  // "r2_buckets": [
  //   {
  //     "binding": "MEDIA",
  //     "bucket_name": "semingenieria-media"
  //   }
  // ],
  // Turnstile producción (widget Semingepy). Para local: key de prueba 1x00000000000000000000AA
  // https://developers.cloudflare.com/turnstile/troubleshooting/testing/
  "vars": {
    "TURNSTILE_SITE_KEY": "0x4AAAAAAF6UXSFiurAMXJ-5"
  }
}
