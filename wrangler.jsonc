{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "semingenieria",
  "workers_dev": true,
  "account_id": "deac1cb839e8f43cebe1f05d29e486e6",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-09-21",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    { "pattern": "semingenieria.com.py", "custom_domain": true },
    { "pattern": "www.semingenieria.com.py", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "semingenieria-cms",
      "database_id": "cd7a2375-a972-42df-9277-6431899f03ad",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "semingenieria-media"
    }
  ],
  // Turnstile test keys (siempre pasan). Reemplazá en producción.
  // https://developers.cloudflare.com/turnstile/troubleshooting/testing/
  "vars": {
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA"
  }
}
