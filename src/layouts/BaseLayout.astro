---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SiteBoot from '../components/SiteBoot.astro';
import CmsHydrate from '../components/CmsHydrate.astro';
import '../styles/fonts.css';
import '../styles/icons.css';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  active?: string;
}

const {
  title,
  description = 'SEM Ingeniería: soluciones en ingeniería eléctrica, electrónica, electromecánica y sistemas contra incendios en Paraguay.',
  active = '',
} = Astro.props;

const siteUrl = 'https://semingenieria.com.py';
const canonical = new URL(Astro.url.pathname, siteUrl).href;
const ogImage = new URL('/og-default.png', siteUrl).href;
const ogImageAlt = 'SEM Ingeniería — soluciones integrales en energía, montaje industrial y prevención en Paraguay';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${siteUrl}/#organization`,
  name: 'SEM Ingeniería',
  url: siteUrl,
  logo: `${siteUrl}/logo.png`,
  image: ogImage,
  description,
  telephone: '+595976129559',
  email: 'info@semingenieria.com.py',
  areaServed: {
    '@type': 'Country',
    name: 'Paraguay',
  },
  address: {
    '@type': 'PostalAddress',
    addressCountry: 'PY',
  },
  sameAs: ['https://wa.me/595976129559'],
  contactPoint: [
    {
      '@type': 'ContactPoint',
      telephone: '+595976129559',
      contactType: 'customer service',
      areaServed: 'PY',
      availableLanguage: ['es'],
    },
  ],
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '07:00',
      closes: '17:00',
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: 'Saturday',
      opens: '08:00',
      closes: '12:00',
    },
  ],
};
---

<!DOCTYPE html>
<html lang="es" class="site-booting">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_PY" />
    <meta property="og:site_name" content="SEM Ingeniería" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <link rel="preload" href="/fonts/poppins-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/poppins-700.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/logo-180.webp" as="image" type="image/webp" />
    <script is:inline>
      try {
        if (sessionStorage.getItem('sem-boot-done') === '1') {
          document.documentElement.classList.remove('site-booting');
        }
      } catch (e) {}
    </script>
  </head>
  <body>
    <SiteBoot />
    <Header active={active} />
    <slot />
    <Footer />
    <CmsHydrate />

    <script>
      const reveals = document.querySelectorAll('.reveal');
      if (reveals.length && 'IntersectionObserver' in window) {
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce) {
          reveals.forEach((el) => el.classList.add('is-visible'));
        } else {
          const io = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  entry.target.classList.add('is-visible');
                  io.unobserve(entry.target);
                }
              });
            },
            { threshold: 0.12, rootMargin: '0px 0px -40px 0px' },
          );
          reveals.forEach((el) => io.observe(el));
        }
      } else {
        reveals.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
