---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SiteBoot from '../components/SiteBoot.astro';
import '../styles/global.css';

interface Props {
  title: string;
  active?: string;
  showFooter?: boolean;
}

const { title, active = '', showFooter = true } = Astro.props;
---

<!DOCTYPE html>
<html lang="es" class="site-booting">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/logo.png" />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />
    <script is:inline>
      try {
        if (sessionStorage.getItem('sem-boot-done') === '1') {
          document.documentElement.classList.remove('site-booting');
        }
      } catch (e) {}
    </script>
  </head>
  <body>
    <SiteBoot />
    <Header active={active} />
    <slot />
    {showFooter && <Footer />}
  </body>
</html>
