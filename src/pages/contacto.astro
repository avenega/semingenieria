---
import BaseLayout from '../layouts/BaseLayout.astro';

const canales = [
  {
    icon: 'fa-phone-volume',
    label: 'Teléfono',
    value: '0976 129 559',
    href: 'tel:0976129559',
    hint: 'Atención directa',
  },
  {
    icon: 'fa-envelope',
    label: 'Correo',
    value: 'info@semingenieria.com.py',
    href: 'mailto:info@semingenieria.com.py',
    hint: 'Consultas y cotizaciones',
  },
  {
    icon: 'fa-brands fa-whatsapp',
    label: 'WhatsApp',
    value: '+595 976 129 559',
    href: 'https://wa.me/595976129559',
    hint: 'Respuesta ágil',
    external: true,
    brand: 'wa',
  },
  {
    icon: 'fa-clock',
    label: 'Horario',
    value: 'Lun–Vie 07:00–17:00',
    href: null,
    hint: 'Sábados 08:00–12:00',
  },
];
---

<BaseLayout
  title="SEM Ingeniería - Contacto"
  description="Contactá a SEM Ingeniería: teléfono 0976 129 559, correo info@semingenieria.com.py y WhatsApp."
  active="contacto"
>
  <section class="contact-hero">
    <div class="contact-hero-inner">
      <p class="contact-kicker">Hablemos de tu proyecto</p>
      <h1 class="contact-title">Contacto</h1>
      <p class="contact-lead">
        Estamos listos para acompañarte en ingeniería eléctrica, montajes industriales y
        sistemas de prevención. Elegí el canal que prefieras o escribinos desde el formulario.
      </p>
    </div>
  </section>

  <div class="contact-page">
    <div class="contact-channels">
      {
        canales.map((c) => {
          const iconClass = c.icon.startsWith('fa-brands')
            ? c.icon
            : `fa-solid ${c.icon}`;
          const Tag = c.href ? 'a' : 'div';
          const extra = c.href
            ? {
                href: c.href,
                ...(c.external ? { target: '_blank', rel: 'noopener noreferrer' } : {}),
              }
            : {};
          return (
            <Tag class:list={['contact-channel', 'reveal', c.brand && `is-${c.brand}`]} {...extra}>
              <span class="contact-channel-icon">
                <i class={iconClass} aria-hidden="true" />
              </span>
              <span class="contact-channel-body">
                <span class="contact-channel-label">{c.label}</span>
                <span
                  class="contact-channel-value"
                  data-cms-phone={c.label === 'Teléfono' ? true : undefined}
                  data-cms-email={c.label === 'Correo' ? true : undefined}
                >
                  {c.value}
                </span>
                <span class="contact-channel-hint">{c.hint}</span>
              </span>
            </Tag>
          );
        })
      }
    </div>

    <div class="contact-main">
      <aside class="contact-aside reveal">
        <div class="contact-aside-badge">
          <i class="fa-solid fa-shield-halved" aria-hidden="true"></i>
        </div>
        <h2>Compromiso SEM</h2>
        <p>
          Garantía de calidad, responsabilidad técnica y seguridad en cada proyecto dentro del
          territorio nacional.
        </p>
        <ul class="contact-aside-list">
          <li>
            <i class="fa-solid fa-check" aria-hidden="true"></i>
            Asesoramiento técnico personalizado
          </li>
          <li>
            <i class="fa-solid fa-check" aria-hidden="true"></i>
            Cobertura en todo el Paraguay
          </li>
          <li>
            <i class="fa-solid fa-check" aria-hidden="true"></i>
            Respuesta ágil a cotizaciones
          </li>
        </ul>
        <a
          href="https://wa.me/595976129559"
          class="contact-wa"
          target="_blank"
          rel="noopener noreferrer"
          data-cms-wa
        >
          <i class="fa-brands fa-whatsapp" aria-hidden="true"></i>
          Escribinos por WhatsApp
        </a>
      </aside>

      <div class="contact-form-shell reveal">
        <div class="contact-form-head">
          <h2>Enviar consulta</h2>
          <p>Completá los datos y te contactamos a la brevedad.</p>
        </div>
        <form class="contact-form" id="contact-form" novalidate>
          <div class="form-row">
            <div class="form-group">
              <label for="name">Nombre / Empresa</label>
              <input
                type="text"
                id="name"
                name="name"
                class="form-control"
                placeholder="Ej. Constructora S.A."
                required
                autocomplete="organization"
              />
            </div>
            <div class="form-group">
              <label for="phone">Teléfono</label>
              <input
                type="tel"
                id="phone"
                name="phone"
                class="form-control"
                placeholder="Ej. 0976 000 000"
                autocomplete="tel"
              />
            </div>
          </div>
          <div class="form-group">
            <label for="email">Correo de contacto</label>
            <input
              type="email"
              id="email"
              name="email"
              class="form-control"
              placeholder="ejemplo@correo.com"
              required
              autocomplete="email"
            />
          </div>
          <div class="form-group">
            <label for="message">Detalle del proyecto o solicitud</label>
            <textarea
              id="message"
              name="message"
              rows="5"
              class="form-control"
              placeholder="Describí brevemente los requerimientos eléctricos, industriales o contra incendios..."
              required
              minlength="10"></textarea>
          </div>
          <!-- Honeypot anti-bot -->
          <div class="hp-field" aria-hidden="true">
            <label for="website">Sitio web</label>
            <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
          </div>
          <div class="form-group">
            <div id="turnstile-slot" class="turnstile-slot"></div>
          </div>
          <p id="contact-form-status" class="contact-form-status" role="status" hidden></p>
          <button type="submit" class="btn-submit" id="contact-submit">
            Enviar mensaje
            <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
          </button>
        </form>
      </div>
    </div>

    <section class="contact-coverage reveal">
      <div class="contact-coverage-glow" aria-hidden="true"></div>
      <div class="contact-coverage-content">
        <span class="contact-coverage-icon">
          <i class="fa-solid fa-earth-americas" aria-hidden="true"></i>
        </span>
        <div>
          <h3>Zona de cobertura</h3>
          <p data-cms-text="coverage_text">
            Ejecutamos obras, montajes mecánicos y de ingeniería en todo el territorio de la
            República del Paraguay.
          </p>
        </div>
      </div>
    </section>
  </div>

  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer></script>
  <script is:inline>
    (function () {
      const form = document.getElementById('contact-form');
      if (!form) return;

      const statusEl = document.getElementById('contact-form-status');
      const submitBtn = document.getElementById('contact-submit');
      const slot = document.getElementById('turnstile-slot');
      let widgetId = null;
      let siteKey = '';

      function setStatus(type, text) {
        if (!statusEl) return;
        statusEl.hidden = !text;
        statusEl.textContent = text || '';
        statusEl.className = 'contact-form-status' + (type ? ' is-' + type : '');
      }

      function resetTurnstile() {
        if (widgetId != null && window.turnstile) {
          window.turnstile.reset(widgetId);
        }
      }

      function renderTurnstile() {
        if (!slot || !siteKey || !window.turnstile) return;
        if (widgetId != null) return;
        widgetId = window.turnstile.render(slot, {
          sitekey: siteKey,
          theme: 'dark',
          language: 'es',
        });
      }

      function waitTurnstile(cb) {
        if (window.turnstile) {
          cb();
          return;
        }
        let tries = 0;
        const t = setInterval(function () {
          tries += 1;
          if (window.turnstile || tries > 40) {
            clearInterval(t);
            if (window.turnstile) cb();
          }
        }, 150);
      }

      fetch('/api/public/config')
        .then(function (r) {
          return r.json();
        })
        .then(function (cfg) {
          siteKey = cfg.turnstileSiteKey || '';
          if (!siteKey) {
            setStatus('error', 'Captcha no disponible. Intentá más tarde.');
            return;
          }
          waitTurnstile(renderTurnstile);
        })
        .catch(function () {
          setStatus('error', 'No se pudo cargar la configuración del formulario.');
        });

      form.addEventListener('submit', async function (e) {
        e.preventDefault();
        setStatus('', '');

        const name = (form.name.value || '').trim();
        const email = (form.email.value || '').trim();
        const phone = (form.phone.value || '').trim();
        const message = (form.message.value || '').trim();
        const website = (form.website && form.website.value) || '';

        if (name.length < 2) {
          setStatus('error', 'Ingresá tu nombre o empresa');
          return;
        }
        if (!email) {
          setStatus('error', 'Ingresá un correo válido');
          return;
        }
        if (message.length < 10) {
          setStatus('error', 'El mensaje debe tener al menos 10 caracteres');
          return;
        }

        let token = '';
        if (window.turnstile && widgetId != null) {
          token = window.turnstile.getResponse(widgetId) || '';
        }
        if (!token) {
          setStatus('error', 'Completá el captcha');
          return;
        }

        submitBtn.disabled = true;
        submitBtn.classList.add('is-loading');
        setStatus('pending', 'Enviando mensaje…');

        try {
          const res = await fetch('/api/public/contact', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              name: name,
              email: email,
              phone: phone,
              message: message,
              website: website,
              turnstileToken: token,
            }),
          });
          const data = await res.json().catch(function () {
            return {};
          });
          if (!res.ok) {
            throw new Error(data.error || 'No se pudo enviar el mensaje');
          }
          form.reset();
          resetTurnstile();
          setStatus(
            'ok',
            '¡Mensaje enviado! Te contactaremos a la brevedad.',
          );
        } catch (err) {
          resetTurnstile();
          setStatus('error', err.message || 'Error al enviar');
        } finally {
          submitBtn.disabled = false;
          submitBtn.classList.remove('is-loading');
        }
      });
    })();
  </script>
</BaseLayout>
