---
import BaseLayout from '../layouts/BaseLayout.astro';

const canales = [
  {
    icon: 'fa-phone-volume',
    label: 'Teléfono',
    value: '0976 129 559',
    href: 'tel:0976129559',
    hint: 'Atención directa',
  },
  {
    icon: 'fa-envelope',
    label: 'Correo',
    value: 'info@semingenieria.com.py',
    href: 'mailto:info@semingenieria.com.py',
    hint: 'Consultas y cotizaciones',
  },
  {
    icon: 'fa-brands fa-whatsapp',
    label: 'WhatsApp',
    value: '+595 976 129 559',
    href: 'https://wa.me/595976129559',
    hint: 'Respuesta ágil',
    external: true,
    brand: 'wa',
  },
  {
    icon: 'fa-clock',
    label: 'Horario',
    value: 'Lun–Vie 07:00–17:00',
    href: null,
    hint: 'Sábados 08:00–12:00',
  },
];
---

<BaseLayout
  title="SEM Ingeniería - Contacto"
  description="Contactá a SEM Ingeniería: teléfono 0976 129 559, correo info@semingenieria.com.py y WhatsApp."
  active="contacto"
>
  <section class="contact-hero">
    <div class="contact-hero-inner">
      <p class="contact-kicker">Hablemos de tu proyecto</p>
      <h1 class="contact-title">Contacto</h1>
      <p class="contact-lead">
        Estamos listos para acompañarte en ingeniería eléctrica, montajes industriales y
        sistemas de prevención. Elegí el canal que prefieras o escribinos desde el formulario.
      </p>
    </div>
  </section>

  <div class="contact-page">
    <div class="contact-channels">
      {
        canales.map((c) => {
          const iconClass = c.icon.startsWith('fa-brands')
            ? c.icon
            : `fa-solid ${c.icon}`;
          const Tag = c.href ? 'a' : 'div';
          const extra = c.href
            ? {
                href: c.href,
                ...(c.external ? { target: '_blank', rel: 'noopener noreferrer' } : {}),
              }
            : {};
          return (
            <Tag class:list={['contact-channel', 'reveal', c.brand && `is-${c.brand}`]} {...extra}>
              <span class="contact-channel-icon">
                <i class={iconClass} aria-hidden="true" />
              </span>
              <span class="contact-channel-body">
                <span class="contact-channel-label">{c.label}</span>
                <span
                  class="contact-channel-value"
                  data-cms-phone={c.label === 'Teléfono' ? true : undefined}
                  data-cms-email={c.label === 'Correo' ? true : undefined}
                >
                  {c.value}
                </span>
                <span class="contact-channel-hint">{c.hint}</span>
              </span>
            </Tag>
          );
        })
      }
    </div>

    <div class="contact-main">
      <aside class="contact-aside reveal">
        <div class="contact-aside-badge">
          <i class="fa-solid fa-shield-halved" aria-hidden="true"></i>
        </div>
        <h2>Compromiso SEM</h2>
        <p>
          Garantía de calidad, responsabilidad técnica y seguridad en cada proyecto dentro del
          territorio nacional.
        </p>
        <ul class="contact-aside-list">
          <li>
            <i class="fa-solid fa-check" aria-hidden="true"></i>
            Asesoramiento técnico personalizado
          </li>
          <li>
            <i class="fa-solid fa-check" aria-hidden="true"></i>
            Cobertura en todo el Paraguay
          </li>
          <li>
            <i class="fa-solid fa-check" aria-hidden="true"></i>
            Respuesta ágil a cotizaciones
          </li>
        </ul>
        <a
          href="https://wa.me/595976129559"
          class="contact-wa"
          target="_blank"
          rel="noopener noreferrer"
          data-cms-wa
        >
          <i class="fa-brands fa-whatsapp" aria-hidden="true"></i>
          Escribinos por WhatsApp
        </a>
      </aside>

      <div class="contact-form-shell reveal">
        <div class="contact-form-head">
          <h2>Enviar consulta</h2>
          <p>Completá los datos y te contactamos a la brevedad.</p>
        </div>
        <form class="contact-form" id="contact-form">
          <div class="form-row">
            <div class="form-group">
              <label for="name">Nombre / Empresa</label>
              <input
                type="text"
                id="name"
                name="name"
                class="form-control"
                placeholder="Ej. Constructora S.A."
                required
                minlength="2"
                maxlength="120"
                autocomplete="name"
                aria-invalid="false"
                data-error="name-error"
              />
              <p id="name-error" class="field-error" hidden>Ingresá tu nombre o empresa (mín. 2 caracteres).</p>
            </div>
            <div class="form-group">
              <label for="phone">Teléfono</label>
              <input
                type="tel"
                id="phone"
                name="phone"
                class="form-control"
                placeholder="Ej. 0976 000 000"
                autocomplete="tel"
                inputmode="tel"
                aria-invalid="false"
                data-error="phone-error"
              />
              <p id="phone-error" class="field-error" hidden>Revisá el número de teléfono.</p>
            </div>
          </div>
          <div class="form-group">
            <label for="email">Correo de contacto</label>
            <input
              type="email"
              id="email"
              name="email"
              class="form-control"
              placeholder="ejemplo@correo.com"
              required
              autocomplete="email"
              aria-invalid="false"
              data-error="email-error"
            />
            <p id="email-error" class="field-error" hidden>Ingresá un correo válido.</p>
          </div>
          <div class="form-group">
            <label for="message">Detalle del proyecto o solicitud</label>
            <textarea
              id="message"
              name="message"
              rows="5"
              class="form-control"
              placeholder="Describí brevemente los requerimientos eléctricos, industriales o contra incendios..."
              required
              minlength="10"
              aria-invalid="false"
              data-error="message-error"
            ></textarea>
            <p id="message-error" class="field-error" hidden>El mensaje debe tener al menos 10 caracteres.</p>
          </div>
          <!-- Honeypot anti-bot -->
          <div class="hp-field" aria-hidden="true">
            <label for="website">Sitio web</label>
            <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
          </div>
          <div class="form-group">
            <div id="turnstile-slot" class="turnstile-slot"></div>
          </div>
          <p id="contact-form-status" class="contact-form-status" role="status" aria-live="polite" hidden></p>
          <div id="contact-form-announcer" class="visually-hidden" aria-live="polite"></div>
          <button type="submit" class="btn-submit" id="contact-submit">
            Enviar mensaje
            <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
          </button>
        </form>
      </div>
    </div>

    <section class="contact-coverage reveal">
      <div class="contact-coverage-glow" aria-hidden="true"></div>
      <div class="contact-coverage-content">
        <span class="contact-coverage-icon">
          <i class="fa-solid fa-earth-americas" aria-hidden="true"></i>
        </span>
        <div>
          <h3>Zona de cobertura</h3>
          <div data-cms-html="coverage_text">
            Ejecutamos obras, montajes mecánicos y de ingeniería en todo el territorio de la
            República del Paraguay.
          </div>
        </div>
      </div>
    </section>
  </div>

  <script>
    let turnstileLoading = false;
    let siteKeyCache = '';

    function initContactForm() {
      const form = document.getElementById('contact-form');
      if (!form || form.dataset.bound === '1') return;
      form.dataset.bound = '1';

      const statusEl = document.getElementById('contact-form-status');
      const announcer = document.getElementById('contact-form-announcer');
      const submitBtn = document.getElementById('contact-submit');
      const slot = document.getElementById('turnstile-slot');
      const fields = ['name', 'email', 'phone', 'message']
        .map((id) => form.elements.namedItem(id))
        .filter(Boolean);

      let widgetId = null;
      let siteKey = siteKeyCache;
      let turnstileReady = false;
      let armed = false;
      let announceTimer;

      function setStatus(type, text) {
        if (!statusEl) return;
        statusEl.hidden = !text;
        statusEl.textContent = text || '';
        statusEl.className = 'contact-form-status' + (type ? ' is-' + type : '');
      }

      function linkError(el, shown) {
        const errorId = el.dataset?.error;
        if (!errorId) return;
        const ids = (el.getAttribute('aria-describedby') || '')
          .split(/\s+/)
          .filter((id) => id && id !== errorId);
        if (shown) ids.push(errorId);
        if (ids.length) el.setAttribute('aria-describedby', ids.join(' '));
        else el.removeAttribute('aria-describedby');
        const err = document.getElementById(errorId);
        if (err) err.hidden = !shown;
      }

      function syncAria(el, announce = false) {
        if (!el?.matches?.('input, select, textarea')) return;
        const invalid = el.matches(':user-invalid');
        el.setAttribute('aria-invalid', invalid ? 'true' : 'false');
        linkError(el, invalid);
        el.closest('.form-group')?.classList.toggle('is-invalid', invalid);
        if (announce && invalid && announcer) {
          const err = document.getElementById(el.dataset.error);
          clearTimeout(announceTimer);
          announcer.textContent = '';
          announceTimer = setTimeout(() => {
            announcer.textContent = err?.textContent?.trim() || 'Revisá este campo';
          }, 500);
        }
      }

      fields.forEach((el) => {
        el.setAttribute('aria-invalid', 'false');
        el.addEventListener('input', () => {
          el.setCustomValidity?.('');
          syncAria(el);
        });
        el.addEventListener('blur', () => syncAria(el, true));
        el.addEventListener('invalid', () => syncAria(el));
      });

      function resetTurnstile() {
        if (widgetId != null && window.turnstile) window.turnstile.reset(widgetId);
      }

      function renderTurnstile() {
        if (!slot || !siteKey || !window.turnstile || widgetId != null) return;
        widgetId = window.turnstile.render(slot, {
          sitekey: siteKey,
          theme: 'dark',
          language: 'es',
        });
        turnstileReady = true;
      }

      function loadTurnstileScript(cb) {
        if (window.turnstile) {
          cb();
          return;
        }
        if (turnstileLoading) {
          let tries = 0;
          const t = setInterval(() => {
            tries += 1;
            if (window.turnstile || tries > 40) {
              clearInterval(t);
              if (window.turnstile) cb();
            }
          }, 150);
          return;
        }
        turnstileLoading = true;
        const s = document.createElement('script');
        s.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
        s.async = true;
        s.defer = true;
        s.onload = () => cb();
        s.onerror = () => {
          turnstileLoading = false;
          setStatus('error', 'No se pudo cargar el captcha. Intentá más tarde.');
        };
        document.head.appendChild(s);
      }

      function ensureTurnstile() {
        if (!siteKey) {
          fetch('/api/public/config')
            .then((r) => r.json())
            .then((cfg) => {
              siteKey = cfg.turnstileSiteKey || '';
              siteKeyCache = siteKey;
              if (!siteKey) {
                setStatus('error', 'Captcha no disponible. Intentá más tarde.');
                return;
              }
              loadTurnstileScript(renderTurnstile);
            })
            .catch(() => {
              setStatus('error', 'No se pudo cargar la configuración del formulario.');
            });
          return;
        }
        loadTurnstileScript(renderTurnstile);
      }

      function armTurnstile() {
        if (armed) return;
        armed = true;
        ensureTurnstile();
      }

      form.addEventListener('focusin', armTurnstile);
      form.addEventListener('pointerdown', armTurnstile, { once: true });

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        setStatus('', '');
        fields.forEach((el) => el?.setCustomValidity?.(''));

        if (!form.checkValidity()) {
          fields.forEach((el) => syncAria(el));
          const firstInvalid = fields.find((el) => el && !el.validity.valid);
          firstInvalid?.focus();
          form.reportValidity();
          return;
        }

        armTurnstile();

        const name = (form.name.value || '').trim();
        const email = (form.email.value || '').trim();
        const phone = (form.phone.value || '').trim();
        const message = (form.message.value || '').trim();
        const website = (form.website && form.website.value) || '';

        let token = '';
        if (window.turnstile && widgetId != null) {
          token = window.turnstile.getResponse(widgetId) || '';
        }
        if (!token) {
          setStatus('error', turnstileReady ? 'Completá el captcha' : 'Cargando captcha…');
          if (!turnstileReady) ensureTurnstile();
          return;
        }

        submitBtn.disabled = true;
        submitBtn.classList.add('is-loading');
        setStatus('pending', 'Enviando mensaje…');

        try {
          const res = await fetch('/api/public/contact', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              name,
              email,
              phone,
              message,
              website,
              turnstileToken: token,
            }),
          });
          const data = await res.json().catch(() => ({}));
          if (!res.ok) throw new Error(data.error || 'No se pudo enviar el mensaje');
          form.reset();
          fields.forEach((el) => {
            if (!el) return;
            el.setAttribute('aria-invalid', 'false');
            linkError(el, false);
            el.closest('.form-group')?.classList.remove('is-invalid');
          });
          resetTurnstile();
          setStatus('ok', '¡Mensaje enviado! Te contactaremos a la brevedad.');
        } catch (err) {
          resetTurnstile();
          setStatus('error', err.message || 'Error al enviar');
        } finally {
          submitBtn.disabled = false;
          submitBtn.classList.remove('is-loading');
        }
      });
    }

    document.addEventListener('astro:page-load', initContactForm);
    initContactForm();
  </script>
</BaseLayout>
