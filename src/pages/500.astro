---
import '../styles/fonts.css';
import '../styles/icons.css';
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Error del servidor | SEM Ingeniería</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  </head>
  <body class="error-page">
    <main class="error-shell">
      <a href="/" class="error-brand">
        <picture>
          <source srcset="/logo-96.webp" type="image/webp" />
          <img src="/logo.png" alt="SEM Ingeniería" width="56" height="56" decoding="async" />
        </picture>
        <span><span class="logo-text-sem">SEM</span> <span class="logo-text-ing">INGENIERÍA</span></span>
      </a>
      <p class="error-code">500</p>
      <h1>Algo salió mal</h1>
      <p class="error-lead">
        Tuvimos un problema al procesar tu solicitud. Probá de nuevo en unos minutos o escribinos
        desde Contacto.
      </p>
      <div class="error-actions">
        <a class="btn btn-primary" href="/">Ir al inicio</a>
        <a class="btn btn-outline" href="/contacto">Contacto</a>
      </div>
    </main>
  </body>
</html>

<style is:global>
  body.error-page {
    min-height: 100vh;
    margin: 0;
    display: grid;
    place-items: center;
    padding: 2rem 1.25rem;
    background:
      radial-gradient(ellipse 70% 50% at 50% 0%, rgba(223, 177, 33, 0.14), transparent 55%),
      #0b0d11;
    color: #f2f3f5;
    font-family: 'Poppins', sans-serif;
  }
  .error-shell {
    width: min(560px, 100%);
    text-align: center;
  }
  .error-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: inherit;
    font-weight: 700;
    letter-spacing: 0.04em;
    margin-bottom: 1.5rem;
  }
  .error-brand img {
    width: 48px;
    height: 48px;
    object-fit: contain;
  }
  .error-code {
    font-size: clamp(4rem, 14vw, 6.5rem);
    font-weight: 700;
    line-height: 1;
    color: #dfb121;
    margin: 0 0 0.35rem;
    letter-spacing: 0.06em;
  }
  .error-shell h1 {
    font-size: clamp(1.4rem, 4vw, 1.85rem);
    margin: 0 0 0.75rem;
  }
  .error-lead {
    color: #a0a5ad;
    line-height: 1.55;
    margin: 0 0 1.75rem;
  }
  .error-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
  }
</style>
