---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="SEM Ingeniería - Nuestros Servicios"
  description="Ingeniería eléctrica, climatización, seguridad contra incendios, seguridad electrónica y montajes industriales."
  active="servicios"
>
  <header class="page-hero">
    <div class="page-hero-inner">
      <h1 class="page-title">Nuestros Servicios</h1>
      <p class="page-subtitle">
        Ingeniería eléctrica, climatización, prevención contra incendios, seguridad electrónica y
        montajes industriales.
      </p>
    </div>
  </header>

  <div class="container">
    <div class="services-grid cms-pending" data-cms-services aria-busy="true">
      <div class="cms-skeleton" aria-hidden="true"></div>
      <div class="cms-skeleton" aria-hidden="true"></div>
      <div class="cms-skeleton" aria-hidden="true"></div>
    </div>
  </div>
</BaseLayout>
