---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="SEM Ingeniería - Foto de Obras"
  description="Registro visual de montajes industriales, tableros y sistemas contra incendio."
  active="fotos"
>
  <div class="container">
    <h2>Foto de Obras</h2>
    <p class="page-subtitle silver" data-cms-text="fotos_intro">
      Registro visual de montajes industriales, tableros y sistemas contra incendio instalados por
      nuestro equipo.
    </p>

    <div class="gallery-grid cms-pending" data-cms-gallery aria-busy="true">
      <div class="cms-skeleton" aria-hidden="true"></div>
      <div class="cms-skeleton" aria-hidden="true"></div>
      <div class="cms-skeleton" aria-hidden="true"></div>
      <div class="cms-skeleton" aria-hidden="true"></div>
    </div>
  </div>
</BaseLayout>
