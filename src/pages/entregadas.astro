---
import BaseLayout from '../layouts/BaseLayout.astro';

const proyectos = [
  { icon: 'fa-wheat-straw', title: 'Pioneros del Chaco S.A.', sector: 'Sector agroindustrial' },
  { icon: 'fa-ship', title: 'Louis Dreyfus Company (LDC)', sector: 'Operaciones logísticas' },
  { icon: 'fa-mountain-rocks', title: 'LHC Mining', sector: 'Infraestructura minera' },
  { icon: 'fa-gas-pump', title: 'Planta Copetrol - San Antonio', sector: 'Sector combustibles' },
  { icon: 'fa-building-shield', title: 'Planta Industrial Petropar', sector: 'Sector combustibles' },
  { icon: 'fa-box-open', title: 'Grupo Cavallaro', sector: 'Consumo masivo' },
  { icon: 'fa-cart-shopping', title: 'Shopping Mariscal', sector: 'Sector comercial y retail' },
  { icon: 'fa-shirt', title: 'Boarding Group', sector: 'Comercial / a medida' },
  { icon: 'fa-glasses', title: 'Óptica Uno', sector: 'Infraestructura comercial' },
];
---

<BaseLayout
  title="SEM Ingeniería - Obras Entregadas"
  description="Proyectos entregados por SEM Ingeniería en agroindustria, combustibles, minería y comercio."
  active="entregadas"
>
  <div class="container">
    <h2>Obras Entregadas</h2>
    <div class="projects-grid entregadas">
      {
        proyectos.map((p) => (
          <div class="project-card reveal">
            <div class="project-img-placeholder">
              <i class={`fa-solid ${p.icon} fa-2x`} />
            </div>
            <div class="project-info">
              <h3>{p.title}</h3>
              <p>{p.sector}</p>
              <span class="badge success">Entregada</span>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</BaseLayout>
