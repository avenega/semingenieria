---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="SEM Ingeniería - Obras Entregadas"
  description="Proyectos entregados por SEM Ingeniería en agroindustria, combustibles, minería y comercio."
  active="entregadas"
>
  <header class="page-hero">
    <div class="page-hero-inner">
      <h1 class="page-title">Obras Entregadas</h1>
      <p class="page-subtitle">
        Proyectos entregados en agroindustria, combustibles, minería y comercio.
      </p>
    </div>
  </header>

  <div class="container">
    <div class="projects-grid entregadas cms-pending" data-cms-entregadas aria-busy="true">
      <div class="cms-skeleton" aria-hidden="true"></div>
      <div class="cms-skeleton" aria-hidden="true"></div>
      <div class="cms-skeleton" aria-hidden="true"></div>
      <div class="cms-skeleton" aria-hidden="true"></div>
      <div class="cms-skeleton" aria-hidden="true"></div>
      <div class="cms-skeleton" aria-hidden="true"></div>
    </div>
  </div>
</BaseLayout>
