---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="SEM Ingeniería - Soluciones Integrales" active="index">
  <section class="hero">
    <div class="container">
      <img src="/logo.png" alt="SEM Ingeniería" class="hero-logo" />
      <h1>
        <span style="color: #737373;">SEM</span>
        <span style="color: #ffcc29;">INGENIERÍA</span>
      </h1>
      <p>Soluciones Integrales con Energía y Prevención</p>
    </div>
  </section>

  <div class="container">
    <h2>Sobre Nosotros</h2>
    <p class="about-text">
      Somos una empresa que brinda soluciones en ingeniería eléctrica, electrónica y
      electromecánica. Especialistas en montajes industriales, installations técnicas y
      sistemas de protección y combate contra incendios para proyectos residenciales,
      industriales y comerciales.
    </p>
    <div class="mv-grid">
      <div class="mv-card">
        <i class="fa-solid fa-eye"></i>
        <h3>Visión</h3>
        <p style="color: var(--text-muted); margin-top: 10px;">
          Ser una empresa referente en los rubros en la que nos desempeñamos, reconocida por
          la responsabilidad y excelencia en cada proyecto.
        </p>
      </div>
      <div class="mv-card">
        <i class="fa-solid fa-shield-halved"></i>
        <h3>Misión</h3>
        <p style="color: var(--text-muted); margin-top: 10px;">
          Brindar servicios de ingeniería de alta calidad, garantizando seguridad, eficiencia
          y satisfacción a nuestros clientes.
        </p>
      </div>
    </div>
  </div>
</BaseLayout>
