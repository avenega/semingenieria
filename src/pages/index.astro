---
import BaseLayout from '../layouts/BaseLayout.astro';

const pilares = [
  {
    icon: 'fa-bolt',
    title: 'Energía y potencia',
    text: 'Montajes eléctricos de media y baja tensión, tableros y grupos electrógenos para instalaciones confiables.',
  },
  {
    icon: 'fa-fire-extinguisher',
    title: 'Prevención y seguridad',
    text: 'Sistemas de detección y combate contra incendios, CCTV, control de accesos y protección electrónica.',
  },
  {
    icon: 'fa-gears',
    title: 'Montaje industrial',
    text: 'Instalaciones electromecánicas, metalmecánica y climatización para plantas, comercios e industrias.',
  },
];
---

<BaseLayout title="SEM Ingeniería - Soluciones Integrales" active="index">
  <section class="hero">
    <div class="container">
      <img src="/logo.png" alt="SEM Ingeniería" class="hero-logo" />
      <h1>
        <span class="logo-text-sem">SEM</span>{' '}
        <span class="logo-text-ing">INGENIERÍA</span>
      </h1>
      <p data-cms-text="hero_tagline">Soluciones Integrales con Energía y Prevención</p>
      <div class="hero-cta">
        <a href="/servicios" class="btn btn-primary">Ver servicios</a>
        <a href="/contacto" class="btn btn-outline">Contactar</a>
      </div>
    </div>
  </section>

  <div class="container">
    <h2>Sobre Nosotros</h2>
    <p class="about-text" data-cms-text="about_p1">
      En <strong>SEM Ingeniería</strong> ofrecemos soluciones integrales en ingeniería eléctrica,
      electrónica y electromecánica en todo el Paraguay. Acompañamos proyectos residenciales,
      comerciales e industriales con montajes técnicos de calidad, instalaciones especializadas y
      sistemas de protección y combate contra incendios.
    </p>
    <p class="about-text about-text-secondary" data-cms-text="about_p2">
      Trabajamos con responsabilidad técnica, plazos claros y un enfoque en la seguridad de las
      personas y de las instalaciones, desde el diseño hasta la puesta en marcha.
    </p>

    <div class="pillars-grid">
      {
        pilares.map((p, i) => (
          <div class="pillar-card reveal">
            <i class={`fa-solid ${p.icon}`} data-cms-pillar-icon={i + 1} />
            <h3 data-cms-text={`pillar_${i + 1}_title`}>{p.title}</h3>
            <p data-cms-text={`pillar_${i + 1}_text`}>{p.text}</p>
          </div>
        ))
      }
    </div>

    <div class="mv-grid">
      <div class="mv-card reveal">
        <i class="fa-solid fa-eye"></i>
        <h3>Visión</h3>
        <p data-cms-text="vision">
          Ser una empresa referente en los rubros en los que nos desempeñamos, reconocida por la
          responsabilidad y la excelencia en cada proyecto.
        </p>
      </div>
      <div class="mv-card reveal">
        <i class="fa-solid fa-shield-halved"></i>
        <h3>Misión</h3>
        <p data-cms-text="mission">
          Brindar servicios de ingeniería de alta calidad, garantizando seguridad, eficiencia y
          satisfacción a nuestros clientes.
        </p>
      </div>
      <div class="mv-card reveal">
        <i class="fa-solid fa-handshake"></i>
        <h3>Compromiso</h3>
        <p data-cms-text="commitment">
          Ejecutar cada obra con ética profesional, cumplimiento normativo y atención cercana, en
          todo el territorio nacional.
        </p>
      </div>
    </div>
  </div>
</BaseLayout>
