---
interface Props {
  active?: string;
}

const { active = '' } = Astro.props;

const links = [
  { href: '/', id: 'index', label: 'Sobre Nosotros' },
  { href: '/servicios', id: 'servicios', label: 'Nuestros Servicios' },
  { href: '/curso', id: 'curso', label: 'Obras en Curso' },
  { href: '/entregadas', id: 'entregadas', label: 'Obras Entregadas' },
  { href: '/fotos', id: 'fotos', label: 'Foto de Obras' },
  { href: '/contacto', id: 'contacto', label: 'Contacto' },
];
---

<header class="site-header" id="site-header">
  <div class="nav-container">
    <a href="/" class="logo-nav">
      <picture>
        <source srcset="/logo-96.webp" type="image/webp" />
        <img src="/logo.png" alt="SEM Ingeniería Logo" width="40" height="40" decoding="async" />
      </picture>
      <span class="logo-text-sem">SEM</span>{' '}
      <span class="logo-text-ing">INGENIERÍA</span>
    </a>

    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="nav-drawer"
      aria-haspopup="dialog"
      aria-label="Abrir menú"
      id="nav-toggle"
    >
      <span class="nav-toggle-bar" aria-hidden="true"></span>
      <span class="nav-toggle-bar" aria-hidden="true"></span>
      <span class="nav-toggle-bar" aria-hidden="true"></span>
    </button>

    <ul class="nav-menu" id="nav-menu">
      {
        links.map((link) => (
          <li>
            <a href={link.href} class={active === link.id ? 'active' : undefined}>
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<dialog class="nav-drawer" id="nav-drawer" aria-label="Menú de navegación">
  <div class="nav-drawer-scroller">
    <nav class="nav-drawer-sheet">
      <button
        type="button"
        class="nav-drawer-close"
        id="nav-drawer-close"
        aria-label="Cerrar menú"
        autofocus
      >
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
      </button>
      <ul class="nav-drawer-list">
        {
          links.map((link) => (
            <li>
              <a href={link.href} class={active === link.id ? 'active' : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</dialog>

<script>
  /** @type {AbortController | null} */
  let navAbort = null;

  function initNav() {
    const header = document.getElementById('site-header');
    const toggle = document.getElementById('nav-toggle');
    const drawer = document.getElementById('nav-drawer');
    const closeBtn = document.getElementById('nav-drawer-close');
    const scroller = drawer?.querySelector('.nav-drawer-scroller');
    const sheet = drawer?.querySelector('.nav-drawer-sheet');
    if (!header || !toggle || !drawer || !scroller || !sheet) return;

    navAbort?.abort();
    navAbort = new AbortController();
    const { signal } = navAbort;

    function onScroll() {
      header.classList.toggle('is-compact', window.scrollY > 24);
    }

    function syncToggle(open) {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
    }

    function openMenu() {
      if (!drawer.open) drawer.showModal();
      scroller.scrollTo({ left: 0, behavior: 'auto' });
      syncToggle(true);
    }

    function requestClose() {
      scroller.scrollTo({ left: scroller.clientWidth, behavior: 'auto' });
    }

    function forceClose() {
      if (drawer.open) drawer.close();
      syncToggle(false);
    }

    function toggleMenu() {
      if (drawer.open) requestClose();
      else openMenu();
    }

    const io = new IntersectionObserver(
      (entries) => {
        const entry = entries[0];
        if (!entry || !drawer.open) return;
        if (entry.intersectionRatio < 0.05) forceClose();
      },
      { root: scroller, threshold: [0, 0.05, 0.95, 1] },
    );
    io.observe(sheet);
    signal.addEventListener('abort', () => io.disconnect());

    toggle.addEventListener('click', toggleMenu, { signal });
    closeBtn?.addEventListener('click', requestClose, { signal });
    drawer.addEventListener('close', () => syncToggle(false), { signal });
    drawer.addEventListener(
      'cancel',
      (e) => {
        e.preventDefault();
        requestClose();
      },
      { signal },
    );
    sheet.querySelectorAll('a').forEach((a) => a.addEventListener('click', forceClose, { signal }));
    window.addEventListener('scroll', onScroll, { passive: true, signal });
    onScroll();
  }

  document.addEventListener('astro:page-load', initNav);
  initNav();
</script>
